{
  "name": "mulio-cdk",
  "version": "0.1.0",
  "bin": {
    "mulio-cdk": "bin/mulio-cdk.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy": "cdk deploy",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "secrets:populate": "ts-node scripts/manage-secrets.ts",
    "secrets:view": "ts-node scripts/manage-secrets.ts --view",
    "deploy:with-secrets": "npm run secrets:populate && npm run deploy"
  },
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@types/node": "20.1.0",
    "aws-cdk": "^2.1031.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.1.3"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "aws-cdk-lib": "^2.221.0",
    "constructs": "^10.0.0"
  }
}